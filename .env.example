# ============================================================================
# CLIP27 IA — VARIÁVEIS DE AMBIENTE PARA HOSPEDAGEM NA VERCEL (OPCIONAIS)
# ============================================================================
# Nota: O sistema já possui configuração Firebase integrada em firebase-applet-config.json
# e sincroniza as chaves da OpenRouter e Apify por usuário diretamente no Firestore.
# Caso deseje definir chaves padrão no painel da Vercel (Settings -> Environment Variables),
# utilize as variáveis abaixo:

# Chaves padrão opcionais de IA e Radar TikTok Brasil
VITE_OPENROUTER_API_KEY=""
VITE_OPENROUTER_MODEL="google/gemini-3.8-flash"
VITE_APIFY_TOKEN=""

# Configuração Firebase (opcional — substitui o firebase-applet-config.json se preenchido)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Variáveis internas AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
