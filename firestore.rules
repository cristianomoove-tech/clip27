rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'cristianomoove@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Tabela Usuarios_Licencas - Módulo SaaS, Licenciamento e Painel Admin
    match /Usuarios_Licencas/{licenseId} {
      // Leitura e gravação permitidas para o funcionamento do Gatekeeper, Trial e Painel Admin
      allow read, write, delete: if true;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isValidId(userId) || isOwner(userId) || isAdmin();
      allow create, update: if isValidId(userId)
        && incoming().email is string
        && incoming().email.size() <= 120;
      allow delete: if isOwner(userId) || isAdmin();

      // Projects subcollection
      match /projects/{projectId} {
        allow read: if isValidId(userId) || isOwner(userId) || isAdmin();
        allow create, update: if isValidId(userId)
          && isValidId(projectId)
          && incoming().name is string
          && incoming().name.size() <= 128;
        allow delete: if isValidId(userId) && isValidId(projectId);
      }

      // Saved Veo 3 Prompts subcollection
      match /savedPrompts/{promptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
          && isValidId(promptId)
          && incoming().title is string
          && incoming().title.size() <= 128;
        allow update: if (isOwner(userId) || isAdmin())
          && isValidId(promptId)
          && incoming().title is string
          && incoming().title.size() <= 128;
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(promptId);
      }
    }
  }
}
